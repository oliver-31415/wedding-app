# Copy to .env next to compose.yaml on the server and fill in. Never commit .env.

# Public address of the site (used in email links).
APP_URL=https://wedding.wright-guys.com

# Port on the server your reverse proxy forwards to.
WEDDING_PORT=3080

# Long random string that signs logins and guest cookies. Generate once with
#   openssl rand -hex 32
# and never change it (that would sign everyone out).
SESSION_SECRET=

# Who may create an account without an invite: the person setting the wedding
# up. Everyone else joins through a co-host invite (Settings → Hosts).
ALLOWED_SIGNUP_EMAILS=

# Only for a server hosting several couples' weddings: site admins who can
# invite people from /site-admin. Leave empty for a single wedding.
SUPERUSER_EMAILS=

# Email over SMTP (account confirmation, password resets, invites, RSVPs).
# Resend: the username is "resend" and the password is your API key.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
# A sender on a domain you've verified in Resend.
EMAIL_FROM=Wedding <wedding@wright-guys.com>
