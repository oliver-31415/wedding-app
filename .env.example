# Copy to .env.local for local development (all optional in dev).
# DATABASE_URL=file:./data/wedding.db
# UPLOAD_DIR=./data/uploads
# SESSION_SECRET=change-me
# APP_URL=http://localhost:3000
# SMTP_HOST=smtp.resend.com        # unset in dev: emails go to /admin/dev/outbox
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key
# EMAIL_FROM="Wedding <wedding@example.com>"
# Email limits (rolling: last 24 hours / last 31 days), shared by every wedding on this server.
# EMAIL_DAILY_LIMIT=100      # e.g. Resend's free plan
# EMAIL_MONTHLY_LIMIT=3000
# EMAIL_BULK_RESERVE=10      # left free each day for one-off emails (RSVP confirmations, password resets)
# SIGNUP_MODE=open   # "invite" = only the first account + co-host invites (production default)
# ALLOWED_SIGNUP_EMAILS=groom@example.com   # may sign up without an invite
# SUPERUSER_EMAILS=                          # site admins (multi-wedding servers only)
